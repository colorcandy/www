            }


        }

        // 異動情報
        if (gYC08IdoJohoHPDto.getLstGYCIdoJohoIdoJyhDto().size() >= 1) {

            int addCnt = 0;
            int delCnt = 0;
            GYCIdoJohoIdoJyhDto dto = null;
