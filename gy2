    /**
     * <p>[概 要] createTrailer メソッド。</p>
     * <p>[詳 細] 処理結果リスト・エラーリストのトレーラーを作成する</p>
     * <p>[備 考] </p>
     *
     * @param inputCnt 入力件数
     * @param normalCnt 登録件数
     * @param errorCnt エラー件数
     * @param userId ユーザID
     */
    private void createTrailer(int inputCnt, int normalCnt, int errorCnt, String userId) {

        // 入力ファイル名
        StringBuffer sbInputFileNm = new StringBuffer();
        List<String> setsuzokufileList = this.gYCIdoJohoDao.findListSetsuzokufile();
        for (String setsuzokufile : setsuzokufileList) {
            sbInputFileNm.append(setsuzokufile).append(";");
        }
        String inputFileNm = sbInputFileNm.toString();
        if (inputFileNm.length() > 1) {
            inputFileNm = inputFileNm.substring(0, inputFileNm.length() - 1);
        }

        String trailerLine = "入力ファイル:%s 入力件数:%s件 登録件数:%s件 エラー件数:%s件 処理日時:%s 氏名コード:%s".formatted(
            inputFileNm,
            inputCnt,
            normalCnt,
            errorCnt,
            dateFactory.newLocalDateTime().format(DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm")),
            userId
        );
        // トレーラレコード作成
        rstlistFileLineWriter.writeBlankLine();
        rstlistFileLineWriter.writeFooter(trailerLine);
        errlistFileLineWriter.writeBlankLine();
        errlistFileLineWriter.writeFooter(trailerLine);

        this.klogger.debug("トレーラーレコード：{}", trailerLine);

    }


    /**
     * 
     * <p>[概 要] 人事異動情報振分ファイル名取得メソッド。</p>
     * <p>[詳 細] 人事異動情報振分のファイル名を作成する。</p>
     * <p>[備 考] </p>
     *
     * @param functionId ユーザID／機能ID
     * @param cycleNo サイクル番号
     * @param gymHizuke 業務日付
     * @return エラーリストのファイル名
     */
    private static String getIdoJohoFuriFileName(String functionId, String cycleNo,
            String gymHizuke) {

        // エラーリスト接尾辞
        String errorlistSuffix = "_" + cycleNo + "_";

        // エラーリスト拡張子
        String errorlistExtension = KoseiProperties.get(ERROR_LIST_SUFFIX_PROP_KEY)
                .orElseThrow(() -> new KoseiSystemException(
                        "Property key is not found " + ERROR_LIST_SUFFIX_PROP_KEY));

        return functionId + errorlistSuffix + gymHizuke + errorlistExtension;
    }



    /**
     * <p>[概 要] doOutputWarningMsg メソッド。</p>
     * <p>[詳 細] 警告出力処理</p>
     * <p>[備 考] </p>
     *
     * @param cDto 抽出ワーク
     * @param msg メッセージID
     */
    private void doOutputWarningMsg(GYC08IdoJohoCDto cDto, GYC08MessageId msg) {

        String warnMsg =
                MessageFormat.format(this.messageAccessor.getText(msg), cDto.getNameCd());
        GYCIdoJohoMsgWDto warnDto = new GYCIdoJohoMsgWDto(msg.toString(), warnMsg);
        warnDto.setNameCd(cDto.getNameCd());
        warnDto.setIdohasseinengappi(cDto.getIdohasseinengappi());
        warnDto.setJsysSbtCd(cDto.getJsysSbtCd());
        warnDto.setIdofilegyoNo(cDto.getIdofilegyoNo());
        warnDto.setIdoSbtCd(cDto.getIdoSbtCd());
        warnDto.setErrLevel("W");
        warnDto.setJobId(functionId);
        warnDto.setCreateUserId(cDto.getOperUserId());
        warnDto.setLastUpdateUserId(cDto.getOperUserId());
        // ワーニングメッセージを出力 ⇒ 実際にファイルに出力されるのはGYC05の処理結果リスト
        this.gyc08Dao.insertIdoJohoMsgW(warnDto);

    }



