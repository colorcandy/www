    /**
     * <p>[概 要] execute メソッド。</p>
     * <p>[詳 細] 人事異動情報振分処理のメインロジック</p>
     * <p>[備 考] </p>
     * 
     * @param batchKbn バッチ区分
     * @param userId ユーザＩＤ
     * @param transactionStatus トランザクション状態
     * @param jobSeqId ジョブシーケンス番号
     * @return ジョブ終了コード
     * @throws KoseiBatchException 業務例外
     */
    public int execute(String batchKbn, String userId,
            TransactionStatus transactionStatus, String jobSeqId) {

        try {

            this.klogger.debug("異動情報振分処理　実行部　Start");

            this.transactionStatus = transactionStatus;



            // 業務日付取得
            LocalDate gymHizuke = dateFactory.getBusinessDate();
            String gymHizukeStr =
                    gymHizuke.format(KoseiDateUtils.getJPyyyyMMddFormatter());
            gymHizukePlus = gymHizuke;

            // 人事異動情報振分処理結果出力先ファイルパス
            Path rstListFilePath = null;
            // 人事異動情報振分エラーリスト出力先ファイルパス
            Path errListFilePath = null;


            // バッチ区分に応じて出力先設定
            if ("99".equals(batchKbn)) {
                // オンバッチ

                // 出力ディレクトリ作成
                String onBatOutputDir =
                        this.onBatListOutputDirOnbat + jobSeqId + File.separator;
                File outFile = new File(onBatOutputDir);

                if (!outFile.exists()) {
                    if (!outFile.mkdirs()) {
                        // 作成エラーの場合は致命的エラー（システムエラー）
                        throw new KoseiSystemException(
                                SSB00F999.value());
                    }
                } else {
                    // 既存のファイルはすべて削除
                    // File[] files = outFile.listFiles();
                    // for(int i=0; i < files.length; i++) {
                    // files[i].delete();
                    // }
                }

                // 人事異動情報ダンプ出力ファイル名(処理結果リストファイル)
                String onBatRstFileName = KoseiOutputListUtils.getResultListFileName(
                        this.functionName, this.dateFactory.newLocalDateTime());

                // 人事異動情報振分処理結果出力先ファイルパス
                rstListFilePath = Paths.get(onBatOutputDir, onBatRstFileName);

                // 人事異動情報ダンプ出力ファイル名(オンバッチ エラーリスト）
                String onBatErrFileName = KoseiOutputListUtils.getErrorListFileName(
                        this.functionName, this.dateFactory.newLocalDateTime());

                // 人事異動情報振分エラーリスト出力先ファイルパス
                errListFilePath = Paths.get(onBatOutputDir, onBatErrFileName);

            } else {
                // 日次バッチ
                gymHizukePlus = gymHizukePlus.plusDays(1);

                // サイクル番号取得
                GyGymCycleBangouDto cycleBangouDto = cycleBangouDao.findOneCycleNum();
                String cycleBangou = KoseiStringUtils.lpadding(
                        String.valueOf(cycleBangouDto.getCycleNogenzai()), PAD_LEN,
                        PAD_CHAR);

                // 人事異動情報振分出力ファイル名
                String listFileName =
                        getIdoJohoFuriFileName(functionId, cycleBangou, gymHizukeStr);

                String rstListOutputDir =
                        this.listOutputDirBatch + "gyc08f01" + File.separator;
                String errListOutputDir =
                        this.listOutputDirBatch + "gyc08f02" + File.separator;

                // 人事異動情報振分処理結果出力先ファイルパス
                rstListFilePath = Paths.get(rstListOutputDir, listFileName);
                // 人事異動情報振分エラーリスト出力先ファイルパス
                errListFilePath = Paths.get(errListOutputDir, listFileName);

            }

            // 会社コード変換情報作成
            Map<String, String> kaishaChgMap = new HashMap<>();
            // 人事異動情報抽出情報のcursor取得
            transactionStatus = KoseiBatchUtils.startTransaction(transactionManager);
            try (Cursor<GYCJsysCodechgDto> colCodeChgKaishaDto =
                    gYCIdoJohoDao.findKaishaChgCodeList(
                            GYCIdoJohoConst.TOUITSUCD_KAISYACD)) {

                for (GYCJsysCodechgDto gYC08JsysCodechgDto : colCodeChgKaishaDto) {

                    // DTOからデータを取得
                    String key = gYC08JsysCodechgDto.getJsysSbtCd() + "/"
                            + gYC08JsysCodechgDto.getJsysbetsuCd();
                    kaishaChgMap.put(key, gYC08JsysCodechgDto.getToitsuCd());
                    this.klogger.debug("    jsysCd:{} sbtCd:{} toiCd:{}",
                            gYC08JsysCodechgDto.getJsysSbtCd(),
                            gYC08JsysCodechgDto.getJsysbetsuCd(),
                            gYC08JsysCodechgDto.getToitsuCd());
                }
            KoseiBatchUtils.commitTransaction(transactionManager, transactionStatus);

            } catch (Exception e) {
                KoseiBatchUtils.endTransaction(transactionManager, transactionStatus);
                throw new KoseiBatchException(SSB00F003, e);
            }


            // 人事異動情報抽出情報のcollector取得
            // Collector<GYC08IdoJohoCDto> colGYC08IdoJohoCDto =
            // new DaoCollector<>(gyc08Dao, "findIdoJohoCList", null);

            List<GYC08IdoJohoCDto> gYC08IdoJohoCDtoList = null;
            gYC08IdoJohoCDtoList = this.gyc08Dao.findIdoJohoCList();

            try {
                try {
                    // 人事異動情報振分処理結果ライター生成
                    rstlistFileLineWriter = new KoseiVariableItemWriter.Builder<>(
                            GYC08IdoJohoMsgWRstFileLayout.class)
                            .filePath(rstListFilePath.toString())
                            .shouldDeleteIfEmpty(false)
                            .build();
                    // ファイルオープン
                    rstlistFileLineWriter.open();
                } catch (KoseiFileException e) {
                    // ファイルオープンエラー
                    throw new KoseiBatchException(SSB00E003, e,
                            rstListFilePath);
                }
                try {

                    // 人事異動情報振分エラーリストライター生成
                    errlistFileLineWriter = new KoseiVariableItemWriter.Builder<>(
                            GYC08IdoJohoMsgWErrFileLayout.class)
                            .filePath(errListFilePath.toString())
                            .shouldDeleteIfEmpty(false)
                            .build();
                    // ファイルオープン
                    errlistFileLineWriter.open();
                } catch (KoseiFileException e) {
                    // ファイルオープンエラー
                    throw new KoseiBatchException(SSB00E003, e,
                            errListFilePath);
                }

                try {
                                    
                    // 処理結果ファイルへヘッダーを出力
                    rstlistFileLineWriter.writeTitle(GYC08IdoJohoMsgWRstFileDto.class);

                    // エラーリストファイルヘッダーを出力
                    errlistFileLineWriter.writeTitle(GYC08IdoJohoMsgWErrFileDto.class);
                    // トレーラーレコード用 処理結果件数
                    int inputCnt = 0;
                    int nomalCnt = 0;
                    int errorCnt = 0;

                    // トランザクション用 DB実行中件数
                    int dbExecutionCnt = 0;


                    // 振分前ＤＴＯを生成
                    GYC08IdoJohoHPDto gYC08IdoJohoHPDto = new GYC08IdoJohoHPDto();

                    // 人事異動情報抽出ワーク用collectorの次要素が存在する間、以下の処理を実施する。
                    // while (colGYC08IdoJohoCDto.hasNext()) {
                    for (GYC08IdoJohoCDto gYC08IdoJohoCDto : gYC08IdoJohoCDtoList) {

                        // 各処理結果コード
                        int rtnCode = 0;

                        // DBしかかり件数
                        dbExecutionCnt++;

                        // DTOからデータを取得
                        // GYC08IdoJohoCDto gYC08IdoJohoCDto = colGYC08IdoJohoCDto.next();
                        // 証跡フィールドは更新
                        gYC08IdoJohoCDto
                                .setCreateUserId(gYC08IdoJohoCDto.getOperUserId());
                        gYC08IdoJohoCDto
                                .setLastUpdateUserId(gYC08IdoJohoCDto.getOperUserId());
                        // 証跡フィールド用ユーザID
                        gYC08IdoJohoCDto.setOperUserId(userId);

                        // 有効データのみ数える。
                        if (YUKO.equals(gYC08IdoJohoCDto.getYukoRecFlg())) {
                            // 入力
                            inputCnt++;
                        }

                        // this.klogger.debug(" 抽出データ （ 社員氏名コード:{} 異動発生年月日:{} ）",
                        // gYC08IdoJohoCDto.getNameCd(),gYC08IdoJohoCDto.getIdohasseinengappi()
                        // );


                        // 初回のみの対応
                        if (KoseiStringUtils.isEmpty(gYC08IdoJohoHPDto.getNameCd())) {
                            // 氏名コードを設定
                            gYC08IdoJohoHPDto.setNameCd(gYC08IdoJohoCDto.getNameCd());
                            // 異動発生年月日を設定
                            gYC08IdoJohoHPDto.setIdohasseinengappi(
                                    gYC08IdoJohoCDto.getIdohasseinengappi());
                            // 業務日付
                            gYC08IdoJohoHPDto.setGymHizuke(gymHizukePlus);
                            // 会社コード変換マップ
                            gYC08IdoJohoHPDto.setKaishaChgMap(kaishaChgMap);
                            // 作成ユーザＩＤ
                            gYC08IdoJohoHPDto.setCreateUserId(userId);
                            // 最終更新ユーザＩＤ
                            gYC08IdoJohoHPDto.setLastUpdateUserId(userId);

                            // ログ出力
                            this.klogger.debug(
                                    "【 処理対象レコード 】 社員氏名コード:{} 異動発生年月日: {} ------>",
                                    gYC08IdoJohoHPDto.getNameCd(),
                                    gYC08IdoJohoHPDto.getIdohasseinengappi());
                        }

                        // 振分前ＤＴＯと取得した処理しているレコードの異動発生年月日と氏名コードが一致しない場合
                        if (!(gYC08IdoJohoCDto.getNameCd()
                                .equals(gYC08IdoJohoHPDto.getNameCd())
                                && gYC08IdoJohoCDto.getIdohasseinengappi().equals(
                                        gYC08IdoJohoHPDto.getIdohasseinengappi()))) {


                            // 人事異動情報のチェックおよび登録処理
                            doIdoJohoChkToroku(gYC08IdoJohoHPDto);
                            // 正常登録件数
                            nomalCnt = nomalCnt + gYC08IdoJohoHPDto.getNomalCnt();
                            // エラー件数
                            errorCnt = errorCnt + gYC08IdoJohoHPDto.getErrorCnt();

                            if (GYCIdoJohoConst.BATCH_KBN_BATCH.equals(batchKbn)) {
                                // DB処理件数とコミット上限件数を比較する
                                if (dbExecutionCnt >= commitLimit) {
                                    this.klogger.debug("    トランザクションの上限に達しました。 処理中件数： {}",
                                            dbExecutionCnt);
                                    // トランザクションのコミット
                                    this.transactionStatus =
                                            KoseiBatchUtils.commitRestartTransaction(
                                                    this.transactionManager,
                                                    this.transactionStatus);
                                    // DB処理件数の初期化
                                    dbExecutionCnt = 0;
                                }
                            }

                            // 以下 振分前ＤＴＯ等 初期化 ----------------------------------->
                            // 振分前ＤＴＯを生成
                            gYC08IdoJohoHPDto = new GYC08IdoJohoHPDto();
                            // 氏名コードを設定
                            gYC08IdoJohoHPDto.setNameCd(gYC08IdoJohoCDto.getNameCd());
                            // 異動発生年月日を設定
                            gYC08IdoJohoHPDto.setIdohasseinengappi(
                                    gYC08IdoJohoCDto.getIdohasseinengappi());
                            // 業務日付
                            gYC08IdoJohoHPDto.setGymHizuke(gymHizukePlus);
                            // 会社コード変換マップ
                            gYC08IdoJohoHPDto.setKaishaChgMap(kaishaChgMap);
                            // 作成ユーザＩＤ
                            gYC08IdoJohoHPDto.setCreateUserId(userId);
                            // 最終更新ユーザＩＤ
                            gYC08IdoJohoHPDto.setLastUpdateUserId(userId);

                            // ログ出力
                            this.klogger.debug(
                                    "【 処理対象レコード 】 社員氏名コード:{} 異動発生年月日: {} ------>",
                                    gYC08IdoJohoHPDto.getNameCd(),
                                    gYC08IdoJohoHPDto.getIdohasseinengappi());

                        }


                        // 取得した人事異動抽出情報を人事異動情報振分前データに格納する。
                        rtnCode = doIdoJohoFullset(gYC08IdoJohoCDto, gYC08IdoJohoHPDto);
                        if (rtnCode != 0) {
                            // 次レコードへ
                            continue;
                        }

                    }

                    // 人事異動情報のチェックおよび登録処理（最終処理レコード用の呼び出し）
                    if (inputCnt > 0) {
                        doIdoJohoChkToroku(gYC08IdoJohoHPDto);
                    }
                    // 正常登録件数
                    nomalCnt = nomalCnt + gYC08IdoJohoHPDto.getNomalCnt();
                    // エラー件数
                    errorCnt = errorCnt + gYC08IdoJohoHPDto.getErrorCnt();
                    
                    // エラーが存在する場合、返却値用変数に50(条件付き正常終了)を設定
                    if(errorCnt > 0) {
                        rtnCd = 50;
                    }

                    // トレーラーレコードを出力
                    createTrailer(inputCnt, nomalCnt, errorCnt, userId);

                    if (GYCIdoJohoConst.BATCH_KBN_BATCH.equals(batchKbn)) {
                        // トランザクションのコミット
                        KoseiBatchUtils.commitTransaction(this.transactionManager,
                                this.transactionStatus);
                    }
 
                    this.klogger.debug("異動情報振分処理　実行部　End");

                } catch (KoseiFileException e) {
                    // ファイル出力エラー
                    throw new KoseiBatchException(SSB00E008, e);
                }

            } finally {

                // ファイルクローズ処理
                KoseiMessages messages = new KoseiMessages();

                if (rstlistFileLineWriter != null) {
                    try {
                        // 処理結果ファイルクローズ
                        rstlistFileLineWriter.close();
                    } catch (KoseiFileException e) {
                        // 処理結果ファイルクローズエラー
                        messages.add(SSB00E004, e, e.getFileName());
                    }
                }


                if (errlistFileLineWriter != null) {
                    try {
                        // エラーリストファイルクローズ
                        errlistFileLineWriter.close();
                    } catch (KoseiFileException e) {
                        // エラーリストファイルクローズエラー
                        messages.add(SSB00E004, e, e.getFileName());
                    }
                }

                // エラーファイル時はエラーメッセージを設定してException返却
                if (!messages.isEmpty()) {
                    throw new KoseiBatchException(messages);
                }

            }

        } finally {

            if (GYCIdoJohoConst.BATCH_KBN_BATCH.equals(batchKbn)) {
                // トランザクション終了（未コミット分はロールバック）
                KoseiBatchUtils.endTransaction(this.transactionManager, this.transactionStatus);
            }
        }

        // 処理結果コード0（正常）返却
        return rtnCd;
    }



    /**
     * <p>[概 要] doIdoJohoFullset メソッド。</p>
     * <p>[詳 細] 取得した人事異動抽出情報を人事異動情報振分前DTOに格納する。</p>
     * <p>[備 考] </p>
     *
     * @param gYC08IdoJohoCDto 人事異動抽出情報
     * @param gYC08IdoJohoHPDto 人事異動情報振分前DTO
     * @return 処理結果
     */
    private int doIdoJohoFullset(GYC08IdoJohoCDto gYC08IdoJohoCDto,
            GYC08IdoJohoHPDto gYC08IdoJohoHPDto) {


        this.klogger.debug("    抽出データ （  社員氏名コード:{} 異動発生年月日:{} ）",
                gYC08IdoJohoCDto.getNameCd(), gYC08IdoJohoCDto.getIdohasseinengappi());


        // 更新前ＤＴＯに異動情報を追加
        gYC08IdoJohoHPDto.getLstGYC08IdoJohoCDto().add(gYC08IdoJohoCDto);

        // すでにエラーが存在
        if (gYC08IdoJohoHPDto.isErrFlg()) {
            return OK;
        }
        // 抽出データの有効フラグが、無効の場合
        if (GYCIdoJohoConst.YUKO_FLG_MUKO.equals(gYC08IdoJohoCDto.getYukoRecFlg())) {
            // エラーフラグを設定
            gYC08IdoJohoHPDto.setErrFlg(true);
            return OK;
        }

        GYCIdoJohoDtoAbst idoDtoAbst = null;

        switch (gYC08IdoJohoCDto.getIdoSbtCd()) {

            // 社員情報
            case GYCIdoJohoConst.SBT_SHAIN:

                // 社員情報処理クラスを使用して共通処理を行う。
                idoDtoAbst =
                        doIdoSbtCommProc((GYC08IdoJohoFileProcAbst) gYCIdoJohoSinJyhProc,
                                gYC08IdoJohoCDto, gYC08IdoJohoHPDto);
                if (idoDtoAbst == null) {
                    // エラーフラグを設定
                    gYC08IdoJohoHPDto.setErrFlg(true);
                } else {
                    // エラーフラグを設定
                    if (idoDtoAbst.isErrFlg())
                        gYC08IdoJohoHPDto.setErrFlg(true);

                    // トレーラーレコード用に会社名と組織名を取得し、変換前DTOに設定する。
                    GYCIdoJohoSinJyhDto gYCIdoJohoSinJyhDto =
                            (GYCIdoJohoSinJyhDto) idoDtoAbst;
                    gYC08IdoJohoHPDto.setShimei(gYCIdoJohoSinJyhDto.getSNameKanjiSei()
                            + " " + gYCIdoJohoSinJyhDto.getSNameKanjiMei());

                    // 会社名、組織名を取得する。
                    //20170215 修正
                    //GYCKaishaSosikiNmDto paramDto = new GYCKaishaSosikiNmDto();
                    GYC08KaishaSosikiNmDto paramDto = new GYC08KaishaSosikiNmDto();
                    paramDto.setKaishaCd(gYCIdoJohoSinJyhDto.getSKaishaCd());
                    paramDto.setSoshikiCd(gYCIdoJohoSinJyhDto.getSSoshikiCd());
                    paramDto.setGyomuHizuke(gYC08IdoJohoHPDto.getGymHizuke());
                    GYC08KaishaSosikiNmDto gYCKaishaSosikiNmDto =
                            this.gyc08Dao.findKaishaSosikiNm(paramDto);
//                    GYCKaishaSosikiNmDto gYCKaishaSosikiNmDto =
//                            this.gYCIdoJohoDao.findKaishaSosikiNm(paramDto);
                    if (gYCKaishaSosikiNmDto != null) {
                        // 振分前ＤＴＯに設定
                        if (gYCKaishaSosikiNmDto.getKaishaseishikiNm() != null) {
                            gYC08IdoJohoHPDto.setKaishaNm(
                                    gYCKaishaSosikiNmDto.getKaishaseishikiNm());
                        }
                        if (gYCKaishaSosikiNmDto.getSoshikiNm() != null) {
                            gYC08IdoJohoHPDto
                                    .setSosikiNm(gYCKaishaSosikiNmDto.getSoshikiNm());
                        }
                    }
                }

                break;


            // 退職情報
            case GYCIdoJohoConst.SBT_TAISHOKU:
                // 退職情報処理クラスを使用して共通処理を行う。
                idoDtoAbst = doIdoSbtCommProc(
                        (GYC08IdoJohoFileProcAbst) gYCIdoJohoTaishokuJyhProc,
                        gYC08IdoJohoCDto, gYC08IdoJohoHPDto);
                if (idoDtoAbst == null || idoDtoAbst.isErrFlg()) {
                    // エラーフラグを設定
                    gYC08IdoJohoHPDto.setErrFlg(true);
                }
                break;


            // 異動情報
            case GYCIdoJohoConst.SBT_IDO:
                // 異動情報処理クラスを使用して共通処理を行う。
                idoDtoAbst =
                        doIdoSbtCommProc((GYC08IdoJohoFileProcAbst) gYCIdoJohoIdoJyhProc,
                                gYC08IdoJohoCDto, gYC08IdoJohoHPDto);
                if (idoDtoAbst == null || idoDtoAbst.isErrFlg()) {
                    // エラーフラグを設定
                    gYC08IdoJohoHPDto.setErrFlg(true);
                }
                break;

            // 出向情報
            case GYCIdoJohoConst.SBT_SYUKKO:
                // 出向情報処理クラスを使用して共通処理を行う。
                idoDtoAbst =
                        doIdoSbtCommProc((GYC08IdoJohoFileProcAbst) gYCIdoJohoSyukkoProc,
                                gYC08IdoJohoCDto, gYC08IdoJohoHPDto);
                if (idoDtoAbst == null || idoDtoAbst.isErrFlg()) {
                    // エラーフラグを設定
                    gYC08IdoJohoHPDto.setErrFlg(true);
                }
                // 出向元先設定処理
                gYCIdoJohoSyukkoProc.syukkoMotoSakiJsyscd(gYC08IdoJohoHPDto, idoDtoAbst);

                if (KoseiStringUtils.isEmpty(gYC08IdoJohoHPDto.getKaishaNm())) {
                    String kaishaCd = "";
                    String sosikiCd = "";
                    // 出向情報
                    GYCIdoJohoSyukkoDto gYCIdoJohoSyukkoDto =
                            (GYCIdoJohoSyukkoDto) idoDtoAbst;
                    if (!KoseiStringUtils.isEmpty(gYCIdoJohoSyukkoDto.getMotoJsysCd())) {
                        kaishaCd = gYCIdoJohoSyukkoDto.getSyukkomotoKaishaCd();
                        sosikiCd = gYCIdoJohoSyukkoDto.getSyukkomotoSoshikiCd();
                    }
                    if (!KoseiStringUtils.isEmpty(gYCIdoJohoSyukkoDto.getSakiJsysCd())) {
                        kaishaCd = gYCIdoJohoSyukkoDto.getSyukkosakiKaishaCd();
                        sosikiCd = gYCIdoJohoSyukkoDto.getSyukkosakiSoshikiCd();
                    }

                    // 会社名、組織名を取得する。
                    GYC08KaishaSosikiNmDto paramDto = new GYC08KaishaSosikiNmDto();
                    paramDto.setKaishaCd(kaishaCd);
                    paramDto.setSoshikiCd(sosikiCd);
                    paramDto.setGyomuHizuke(idoDtoAbst.getGymHizuke());
                    GYC08KaishaSosikiNmDto gYC08KaishaSosikiNmDto =
                            this.gyc08Dao.findKaishaSosikiNm(paramDto);
                    if (gYC08KaishaSosikiNmDto != null) {
                        // 振分前ＤＴＯに設定
                        if (gYC08KaishaSosikiNmDto.getKaishaseishikiNm() != null) {
                            gYC08IdoJohoHPDto.setKaishaNm(
                                    gYC08KaishaSosikiNmDto.getKaishaseishikiNm());
                        }
                        if (gYC08KaishaSosikiNmDto.getSoshikiNm() != null) {
                            gYC08IdoJohoHPDto
                                    .setSosikiNm(gYC08KaishaSosikiNmDto.getSoshikiNm());
                        }
                    }
                }

                break;


            // 休職情報
            case GYCIdoJohoConst.SBT_KYUSYOKU:
                // 異動情報処理クラスを使用して共通処理を行う。
                idoDtoAbst = doIdoSbtCommProc(
                        (GYC08IdoJohoFileProcAbst) gYCIdoJohoKyusyokuJyhProc,
                        gYC08IdoJohoCDto, gYC08IdoJohoHPDto);
                if (idoDtoAbst == null || idoDtoAbst.isErrFlg()) {
                    // エラーフラグを設定
                    gYC08IdoJohoHPDto.setErrFlg(true);
                }
                break;


            // 転籍情報
            case GYCIdoJohoConst.SBT_TENSEKI:
                // 転籍情報処理クラスを使用して共通処理を行う。
                idoDtoAbst = doIdoSbtCommProc(
                        (GYC08IdoJohoFileProcAbst) gYCIdoJohoTensekiJyhProc,
                        gYC08IdoJohoCDto, gYC08IdoJohoHPDto);
                if (idoDtoAbst == null || idoDtoAbst.isErrFlg()) {
                    // エラーフラグを設定
                    gYC08IdoJohoHPDto.setErrFlg(true);
                }
                break;


            default:
                this.klogger.debug("  処理対象外の異動種別：{}", gYC08IdoJohoCDto.getIdoSbtCd());
                // エラーフラグを設定
                gYC08IdoJohoHPDto.setErrFlg(true);

                // 異常を返却
                return NG;

        }



        // 正常を返却
        return OK;
    }



    /**
     * <p>[概 要] doIdoSbtCommProc メソッド。</p>
     * <p>[詳 細] 処理種別共通処理</p>
     * <p>[備 考] </p>
     *
     * @param gYC08IdoJohoCDto 人事異動抽出情報
     * @param idoJohoFileProc 人事異動情報抽象クラス
     * @param gYC08IdoJohoHPDto 振分前DTO
     * @return 処理結果
     */
    private GYCIdoJohoDtoAbst doIdoSbtCommProc(GYC08IdoJohoFileProcAbst idoJohoFileProc,
            GYC08IdoJohoCDto gYC08IdoJohoCDto, GYC08IdoJohoHPDto gYC08IdoJohoHPDto) {

        GYC08MessageId errCode;
        GYCIdoJohoDtoAbst idoJohoDtoAbst = null;

        // 各種異動情報を作成する。
        try {

            // 各種異動情報を作成する。
            idoJohoDtoAbst = idoJohoFileProc.createIdoJohoDTO(gYC08IdoJohoCDto);

            // その他の共通情報を設定
            idoJohoDtoAbst.setFilegyoNo(gYC08IdoJohoCDto.getIdofilegyoNo());
            idoJohoDtoAbst.setNameCd(gYC08IdoJohoCDto.getNameCd());
            idoJohoDtoAbst.setGymHizuke(gYC08IdoJohoHPDto.getGymHizuke());



        } catch (IdoJohohException ex) {
            // エラー処理を実行
            GYC08MessageId rtnMessage = GYC08MessageId.GYC08E058;
            String message =
                    MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                            gYC08IdoJohoCDto.getNameCd());
            this.klogger.debug("IdoJohohException :{}", ex.getMessage());
            // エラー処理を実行
            GYCIdoJohoMsgWDto msgWDto =
                    new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
            doIdoJohoErrOut(gYC08IdoJohoCDto, msgWDto);
            // エラー件数を加算
            gYC08IdoJohoHPDto.setErrorCnt(gYC08IdoJohoHPDto.getErrorCnt() + 1);

            // 生成に失敗したので、Nullで返却
            return null;

        }



        // バリデーションチェック実施
        // String message = idoJohoFileProc.validate(idoJohoDtoAbst);
        // if(message != null) {
        // //エラー処理を実行
        // GYCIdoJohoMsgWDto msgWDto = new GYCIdoJohoMsgWDto("GYC08E000", message);
        // doIdoJohoErrOut(gYC08IdoJohoCDto, msgWDto);
        // //異動情報にエラーフラグを設定
        // idoJohoDtoAbst.setErrFlg(true);
        // return idoJohoDtoAbst;
        // }

        // 人事異動情報振分妥当性チェック
        errCode = idoJohoFileProc.furiwakeValidate(idoJohoDtoAbst);
        if (!GYC08MessageId.GYC08I000.equals(errCode)) {

            if (GYC08MessageId.GYC08W001.equals(errCode)) {
                // 返却値がワーニングだった場合は警告出力処理を行い、次処理続行
                doOutputWarningMsg(gYC08IdoJohoCDto, errCode);
            } else {
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto = new GYCIdoJohoMsgWDto(errCode.toString(),
                        idoJohoDtoAbst.getErrMsg());
                doIdoJohoErrOut(gYC08IdoJohoCDto, msgWDto);
                // 異動情報にエラーフラグを設定
                idoJohoDtoAbst.setErrFlg(true);
                // エラー件数を加算
                gYC08IdoJohoHPDto.setErrorCnt(gYC08IdoJohoHPDto.getErrorCnt() + 1);

                return idoJohoDtoAbst;
            }
        }

        // コード変換処理を行う。
        errCode = idoJohoFileProc.codeChg(idoJohoDtoAbst, jsysCodeChgMap,
                gYC08IdoJohoHPDto.getKaishaChgMap(), sihKbnMap);
        if (!GYC08MessageId.GYC08I000.equals(errCode)) {
            // エラー処理を実行
            GYCIdoJohoMsgWDto msgWDto =
                    new GYCIdoJohoMsgWDto(errCode.toString(), idoJohoDtoAbst.getErrMsg());
            doIdoJohoErrOut(gYC08IdoJohoCDto, msgWDto);
            // 異動情報にエラーフラグを設定
            idoJohoDtoAbst.setErrFlg(true);
            // エラー件数を加算
            gYC08IdoJohoHPDto.setErrorCnt(gYC08IdoJohoHPDto.getErrorCnt() + 1);

            return idoJohoDtoAbst;
        }


        // 変換前DTOに作成した異動情報を登録する。
        idoJohoFileProc.henkanDtoListAdd(gYC08IdoJohoHPDto, idoJohoDtoAbst);

        // 変換前DTOに警告情報を登録する。
        idoJohoFileProc.warnListAdd(gYC08IdoJohoHPDto, idoJohoDtoAbst);



        return idoJohoDtoAbst;
    }



    /**
     * <p>[概 要] doIdoJohoChkToroku メソッド。</p>
     * <p>[詳 細] 異動情報チェック＆登録処理</p>
     * <p>[備 考] </p>
     *
     * @param gYC08IdoJohoHPDto 振分前ＤＴＯ
     */
    private void doIdoJohoChkToroku(GYC08IdoJohoHPDto gYC08IdoJohoHPDto) {

        // 各処理結果コード
        int rtnCode = 0;

        // 人事異動情報振分済みワークテーブル
        GYCIdoJohoHDto paramDto = new GYCIdoJohoHDto();
        paramDto.setIdohasseinengappi(gYC08IdoJohoHPDto.getIdohasseinengappi());
        paramDto.setNameCd(gYC08IdoJohoHPDto.getNameCd());
        // 人事異動情報振分済みワークテーブル
        GYCIdoJohoHDto gYCIdoJohoHDto = null;
        // データ存在フラグ
        boolean exsistFlg = false;

        // 該当レコードがあれば、取得
        gYCIdoJohoHDto = this.gyc08Dao.findIdoJohoHByPk(paramDto);
        if (gYCIdoJohoHDto == null) {
            gYCIdoJohoHDto = new GYCIdoJohoHDto();
        } else {
            // データ存在
            exsistFlg = true;
        }

        gYCIdoJohoHDto.setIdohasseinengappi(gYC08IdoJohoHPDto.getIdohasseinengappi());
        gYCIdoJohoHDto.setNameCd(gYC08IdoJohoHPDto.getNameCd());

        // 登録済フラグ（未登録で登録）
        gYCIdoJohoHDto.setTorokusumiFlg("0");
        gYCIdoJohoHDto.setCreateUserId(gYC08IdoJohoHPDto.getCreateUserId());
        gYCIdoJohoHDto.setLastUpdateUserId(gYC08IdoJohoHPDto.getLastUpdateUserId());


        // 人事異動情報のチェック
        rtnCode = doIdoJohoHCheck(gYC08IdoJohoHPDto, gYCIdoJohoHDto);
        if (rtnCode == OK) {
            // 人事異動情報登録処理
            doIdoJohoToroku(gYC08IdoJohoHPDto, gYCIdoJohoHDto, exsistFlg);

        }
    }



    /**
     * <p>[概 要] doIdoJohoHCheck メソッド。</p>
     * <p>[詳 細] 異動情報振分チェック処理</p>
     * <p>[備 考] </p>
     *
     * @param gYC08IdoJohoHPDto 振分前ＤＴＯ
     * @param gYCIdoJohoHDto 事異動情報振分済みDTO
     * @return 処理結果
     */
    private int doIdoJohoHCheck(GYC08IdoJohoHPDto gYC08IdoJohoHPDto,
            GYCIdoJohoHDto gYCIdoJohoHDto) {

        // ログ出力
        this.klogger.debug("【 チェック開始 】 社員氏名コード:{} 異動発生年月日: {} 対象件数:{} ------>",
                gYC08IdoJohoHPDto.getNameCd(), gYC08IdoJohoHPDto.getIdohasseinengappi(),
                gYC08IdoJohoHPDto.getLstGYC08IdoJohoCDto().size());

        GYC08MessageId rtnMessage = null;

        // エラーフラグチェック
        if (gYC08IdoJohoHPDto.isErrFlg()) {

            // 今のエラー件数を取得
            int errorCnt = gYC08IdoJohoHPDto.getErrorCnt();
            Iterator<GYC08IdoJohoCDto> itr =
                    gYC08IdoJohoHPDto.getLstGYC08IdoJohoCDto().iterator();
            while (itr.hasNext()) {

                // 抽出データを取得
                GYC08IdoJohoCDto dto = (GYC08IdoJohoCDto) itr.next();
                // 有効データであるにもかかわらず、巻き添えでエラーとなるデータを出力
                if (YUKO.equals(dto.getYukoRecFlg())) {
                    rtnMessage = GYC08MessageId.GYC08E057;
                    // エラーメッセージ
                    String message =
                            MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                    gYC08IdoJohoHPDto.getNameCd());
                    // エラー処理を実行
                    GYCIdoJohoMsgWDto msgWDto =
                            new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                    doIdoJohoErrOut(dto, msgWDto);

                    errorCnt++;

                }

            }
            gYC08IdoJohoHPDto.setErrorCnt(errorCnt);


            // ログ出力
            this.klogger.debug("【 チェック結果 】 エラー（無効データ含む）ありのため、登録処理なし。");
            return NG;
        }



        // 以下、出向情報から判別され、その他の箇所で使用するための退避情報
        String syukkoHukkiKbn = "";
        String motoJsysCd = "";
        String sakiJsysCd = "";
        String syukkoSbtCd = "";
        GYCIdoJohoSyukkoDto rec1Dto = new GYCIdoJohoSyukkoDto();
        GYCIdoJohoSyukkoDto rec2Dto = new GYCIdoJohoSyukkoDto();

        // ※ただし、連携された値が35～38の時、異動コードに860:死亡が設定されている場合があり、
        // この場合は厚生系としては01:死亡（退職年月日としても使用）として取り込みを行う のためのフラグ
        boolean siboFlg = false;



        // 出向情報の値をチェックする。
        if (gYC08IdoJohoHPDto.getLstGYCIdoJohoSyukkoDto().size() >= 1) {

            int addCnt = 0;
            int delCnt = 0;
            boolean kaisiFlg = false;
            boolean hukkiFlg = false;

            GYCIdoJohoSyukkoDto dto = new GYCIdoJohoSyukkoDto();
            Iterator<GYCIdoJohoSyukkoDto> itr =
                    gYC08IdoJohoHPDto.getLstGYCIdoJohoSyukkoDto().iterator();
            while (itr.hasNext()) {
                // 人事異動 出向開始を取得する。
                dto = (GYCIdoJohoSyukkoDto) itr.next();

                // 出向開始と復帰の混在判定
                if (GYCIdoJohoConst.SYUKKO_KAISHI.equals(dto.getSyukkoHukkiKbn())) {
                    kaisiFlg = true;
                } else {
                    hukkiFlg = true;
                }

                // 処理種別ごとの件数を算出
                if (GYCIdoJohoConst.SHORISBT_ADD.equals(dto.getShoriSbtHyoji())) {
                    addCnt++;
                } else {
                    delCnt++;
                }

                if (addCnt == 1) {
                    this.mapper.map(dto, rec1Dto);
                } else if (addCnt == 2) {
                    this.mapper.map(dto, rec2Dto);
                }

            }
            // 出向復帰区分を退避
            syukkoHukkiKbn = dto.getSyukkoHukkiKbn();
            // 出向種別を退避
            syukkoSbtCd = dto.getSyukkoSbt();


            if (addCnt > 2) {
                rtnMessage = GYC08MessageId.GYC08E047;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }
            if (delCnt > 0) {
                rtnMessage = GYC08MessageId.GYC08E049;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }

            if (kaisiFlg && hukkiFlg) {
                // 出向開始と出向復帰が同じ異動発生日はエラー
                rtnMessage = GYC08MessageId.GYC08E051;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;

            }
            // 同一人給からの出向情報は組み合わせエラーとする。
            if (addCnt == 2) {
                if (rec1Dto.getJsysSbtCd().equals(rec2Dto.getJsysSbtCd())) {
                    rtnMessage = GYC08MessageId.GYC08E054;
                    String message =
                            MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                    gYC08IdoJohoHPDto.getNameCd());
                    // エラー処理を実行
                    GYCIdoJohoMsgWDto msgWDto =
                            new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                    doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                    // 異常を返却
                    return NG;
                }
            }

            // 出向開始の場合
            if (kaisiFlg) {

                if (addCnt == 1) {
                    motoJsysCd = rec1Dto.getMotoJsysCd();
                    sakiJsysCd = rec1Dto.getSakiJsysCd();
                } else {

                    if (!KoseiStringUtils.isEmpty(rec1Dto.getMotoJsysCd())) {
                        motoJsysCd = rec1Dto.getMotoJsysCd();
                    }
                    if (!KoseiStringUtils.isEmpty(rec1Dto.getSakiJsysCd())) {
                        sakiJsysCd = rec1Dto.getSakiJsysCd();
                    }
                    if (!KoseiStringUtils.isEmpty(rec2Dto.getMotoJsysCd())) {
                        motoJsysCd = rec2Dto.getMotoJsysCd();
                    }
                    if (!KoseiStringUtils.isEmpty(rec2Dto.getSakiJsysCd())) {
                        sakiJsysCd = rec2Dto.getSakiJsysCd();
                    }
                }

                this.klogger.debug("    出向開始 出向元：{}、出向先{}", motoJsysCd, sakiJsysCd);


            }



            // 出向復帰の場合
            if (hukkiFlg) {

                // 出向復帰の場合は、出向しているので、社員情報テーブルの出向先会社コードと出向元会社コードを取得し、
                // 人給システムコードが一致することにより、元先判定をおこなう。
                GYC08ShainKaishaJsysCdDto shainJsysDto = this.gyc08Dao
                        .findShainKaishaJsysCd(gYC08IdoJohoHPDto.getNameCd(), gYC08IdoJohoHPDto.getGymHizuke());
                if (shainJsysDto == null) {
                    // 出向中なのにＤＢに社員情報が存在しない。
                    rtnMessage = GYC08MessageId.GYC08E053;
                    String message =
                            MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                    gYC08IdoJohoHPDto.getNameCd());
                    // エラー処理を実行
                    GYCIdoJohoMsgWDto msgWDto =
                            new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                    doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                    // 異常を返却
                    return NG;
                }
                // 出向元会社の人給システムコードを設定
                if (shainJsysDto.getSyukkomotoJsysCd() != null) {
                    String jsysCd = shainJsysDto.getSyukkomotoJsysCd();
                    if (!(GYCIdoJohoConst.JSYS_INFOGRID.equals(jsysCd)
                            || GYCIdoJohoConst.JSYS_SPEAD.equals(jsysCd)
                            || GYCIdoJohoConst.JSYS_COMS.equals(jsysCd))) {
                        // ３人給で無い場合はその他人給として扱う。
                        jsysCd = GYCIdoJohoConst.JSYS_SONOTA;
                    }
                    motoJsysCd = jsysCd;
                }
                // 出向先会社の人給システムコードを設定
                if (shainJsysDto.getSyukkosakiJsysCd() != null) {
                    String jsysCd = shainJsysDto.getSyukkosakiJsysCd();
                    if (!(GYCIdoJohoConst.JSYS_INFOGRID.equals(jsysCd)
                            || GYCIdoJohoConst.JSYS_SPEAD.equals(jsysCd)
                            || GYCIdoJohoConst.JSYS_COMS.equals(jsysCd))) {
                        // ３人給で無い場合はその他人給として扱う。
                        jsysCd = GYCIdoJohoConst.JSYS_SONOTA;
                    }
                    sakiJsysCd = jsysCd;
                }

                this.klogger.debug("    出向復帰 出向元：{}、出向先{}", motoJsysCd, sakiJsysCd);

            }
        }

        // 社員情報
        if (gYC08IdoJohoHPDto.getLstGYCIdoJohoSinJyhDto().size() >= 1) {

            this.klogger.debug("    社員情報リスト件数：{}",
                    gYC08IdoJohoHPDto.getLstGYCIdoJohoSinJyhDto().size());

            // 組み合わせチェックパラメータ
            int sinkiCnt = 0;
            int isekiCnt = 0;
            int saisaiCnt = 0;
            int sonotaCnt = 0;

            int addCnt = 0;
            int delCnt = 0;
            // 複数データ（出向元、出向先）から振分済みデータを作成する。
            GYCIdoJohoSinJyhDto rec1SinDto = new GYCIdoJohoSinJyhDto();
            GYCIdoJohoSinJyhDto rec2SinDto = new GYCIdoJohoSinJyhDto();



            Iterator<GYCIdoJohoSinJyhDto> itr =
                    gYC08IdoJohoHPDto.getLstGYCIdoJohoSinJyhDto().iterator();
            while (itr.hasNext()) {
                // 人事異動 社員情報を取得する。
                GYCIdoJohoSinJyhDto dto = (GYCIdoJohoSinJyhDto) itr.next();



                // 処理種別ごとの件数を算出
                if (GYCIdoJohoConst.SHORISBT_ADD.equals(dto.getSShoriSbtHyoji())) {
                    addCnt++;

                    String sinsaiKbn = dto.getSSinsaiSaisaiyoKbnCd();

                    // COM人給の場合、発令を伴わない社員情報の変更の場合、新採・再採用区分コード
                    // が前回の値できてしまう対応。
                    if (GYCIdoJohoConst.JSYS_COMS.equals(dto.getSJsysSbtCd()) || 
                            GYCIdoJohoConst.JSYS_SPEAD.equals(dto.getSJsysSbtCd())) {
                        sinsaiKbn = comsSinsaiSaiyoKbnChk(sinsaiKbn,
                                gYCIdoJohoHDto.getNameCd());
                    }

                    // 新採・再採用区分コードの存在チェック
                    switch (sinsaiKbn) {
                        case GYCIdoJohoConst.SHINSAI_SAIYO:
                            sinkiCnt++;
                            break;
                        case GYCIdoJohoConst.SHINSAI_ISEKI:
                            isekiCnt++;
                            break;
                        case GYCIdoJohoConst.SHINSAI_SAISAIYO:
                            saisaiCnt++;
                            break;
                        case " ":
                            sonotaCnt++;
                            break;
                        default:
                            // 新採・再採用区分コードチェック済みのはず。
                            this.klogger.error("    新採・再採用区分コード 不正　新採・再採用区分コード：{}",
                                    dto.getSSinsaiSaisaiyoKbnCd());
                            break;
                    }

                } else {
                    delCnt++;
                }

                if (addCnt == 1 || delCnt == 1) {
                    this.mapper.map(dto, rec1SinDto);
                } else if (addCnt == 2) {
                    this.mapper.map(dto, rec2SinDto);
                }

                // SPEADかつ異動要因コードが死亡（860）の場合、フラグを設定
                if (GYCIdoJohoConst.JSYS_SPEAD.equals(dto.getSJsysSbtCd())
                        && SPEAD_IDO_CD_SIBO.equals(dto.getsIdoCdBak())) {
                    siboFlg = true;
                }

            }

            // 異動情報内の組み合わせチェック
            if (addCnt > 2) {
                rtnMessage = GYC08MessageId.GYC08E047;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }
            if (delCnt > 1) {
                rtnMessage = GYC08MessageId.GYC08E048;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }
            if (addCnt > 0 && delCnt > 0) {
                rtnMessage = GYC08MessageId.GYC08E050;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }
            // その他以外は重複の組み合わせは無効
            if (sinkiCnt == 2 || isekiCnt == 2 || saisaiCnt == 2 || (sonotaCnt == 2
                    && gYC08IdoJohoHPDto.getLstGYCIdoJohoSyukkoDto().size() == 0)) {
                rtnMessage = GYC08MessageId.GYC08E054;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }


            // 振分済DTO設定処理
            if (gYC08IdoJohoHPDto.getLstGYCIdoJohoSyukkoDto().size() == 0) {
                // 出向情報が存在しない場合
                this.mapper.map(rec1SinDto, gYCIdoJohoHDto);

            } else {

                // 出向情報が存在する場合
                //////////////////////////////////////////////////////////
                // 出向情報と社員情報のパターン
                //////////////////////////////////////////////////////////
                // 出向情報 社員情報
                // 出元 出先 出元 出先 結果
                // (1 ) ○ ○ ○ ○ OK ４レコードパターン
                // (2 ) ○ ○ ○ － OK メジャールート
                // (3 ) ○ ○ － ○ OK メジャールートのうら
                // (4 ) ○ ○ － － OK 出向情報のみ（運用上はない） 社員情報なしなので、ここでは関係なし。
                // (5 ) ○ － ○ － OK 出向先がおくれてこなかった。
                // (6 ) ○ － － ○ NG 出向情報と社員情報の人給システムコードと一致しない
                // (7 ) ○ － ○ ○ NG 社員情報が２件あるのに出向情報が２件でない場合はNG
                // (8 ) － ○ － ○ OK 出向元がおくれてこなかった。
                // (9 ) － ○ ○ － NG 出向情報と社員情報の人給システムコードと一致しない
                // (10) － ○ ○ ○ NG 社員情報が２件あるのに出向情報が２件でない場合はNG
                // (11) － － ○ ○ NG 社員情報が２件あるのに出向情報が無い場合はNG

                boolean dataSetErrFlg = false;

                // 社員情報を振分済ＤＴＯの設定処理
                if (addCnt == 1) {
                    // 2016/09/23 Update by Matsui 出向元優先に変更
                    // 社員情報を振分済ＤＴＯに設定する。
                    // this.mapper.map(rec1SinDto, gYCIdoJohoHDto);

                    // 出向情報の人事システムコードと一致したものを出向元・先とする。
                    if (!KoseiStringUtils.isEmpty(motoJsysCd)
                            && !KoseiStringUtils.isEmpty(sakiJsysCd)) {
                        if (motoJsysCd.equals(rec1SinDto.getSJsysSbtCd())) {
                            if (sakiJsysCd.equals(rec1SinDto.getSJsysSbtCd())) {
                                // 同一人給内の異動(出向元、出向先が一致） (2)、(3) 同一人給の異動
                                setShainJoho(gYCIdoJohoHDto, syukkoSbtCd, rec1SinDto,
                                        rec1SinDto);
                            } else {
                                // 出向元の社員情報しかない。 (2)
                                setShainJoho(gYCIdoJohoHDto, syukkoSbtCd, rec1SinDto,
                                        null);
                            }
                        } else if (sakiJsysCd.equals(rec1SinDto.getSJsysSbtCd())) {
                            // 出向先の社員情報しかない。 (3)
                            setShainJoho(gYCIdoJohoHDto, syukkoSbtCd, null, rec1SinDto);
                        }
                    } else if (!KoseiStringUtils.isEmpty(motoJsysCd)) {
                        if (motoJsysCd.equals(rec1SinDto.getSJsysSbtCd())) {
                            // 利用外への出向で出向元の社員情報しかない。(5)
                            setShainJoho(gYCIdoJohoHDto, syukkoSbtCd, rec1SinDto, null);

                        } else {
                            // 出向情報は出向元だが、一致する人給システムの社員情報ではない。(6)
                            dataSetErrFlg = true;
                        }
                    } else if (!KoseiStringUtils.isEmpty(sakiJsysCd)) {
                        if (sakiJsysCd.equals(rec1SinDto.getSJsysSbtCd())) {
                            // 利用外への出向で出向先の社員情報しかない。 (8)
                            setShainJoho(gYCIdoJohoHDto, syukkoSbtCd, null, rec1SinDto);

                        } else {
                            // 出向情報は出向先だが、一致する人給システムの社員情報ではない。 (9)
                            dataSetErrFlg = true;
                        }
                    }
                } else if (addCnt == 2) {
                    // 2016/09/23 Update by Matsui 出向元優先に変更
                    // 後勝ちで社員情報を振分済ＤＴＯに初期設定する。
                    // this.mapper.map(rec2SinDto, gYCIdoJohoHDto);

                    // 出向情報の人事システムコードと一致したものを出向元・先とする。
                    if (!KoseiStringUtils.isEmpty(motoJsysCd)
                            && !KoseiStringUtils.isEmpty(sakiJsysCd)) {
                        if (motoJsysCd.equals(rec1SinDto.getSJsysSbtCd())) {
                            if (sakiJsysCd.equals(rec2SinDto.getSJsysSbtCd())) {
                                // 同一人給内の異動(出向元、出向先が一致） (1)
                                setShainJoho(gYCIdoJohoHDto, syukkoSbtCd, rec1SinDto,
                                        rec2SinDto);
                            } else {
                                // 出向先の社員情報が一致しない。
                                dataSetErrFlg = true;
                            }
                        } else if (motoJsysCd.equals(rec2SinDto.getSJsysSbtCd())) {
                            if (sakiJsysCd.equals(rec1SinDto.getSJsysSbtCd())) {
                                // 同一人給内の異動(出向元、出向先が一致） (1)
                                setShainJoho(gYCIdoJohoHDto, syukkoSbtCd, rec2SinDto,
                                        rec1SinDto);
                            } else {
                                // 出向先の社員情報が一致しない。
                                dataSetErrFlg = true;
                            }
                        }
                    } else {
                        // (7)、(10)、(11)
                        dataSetErrFlg = true;
                    }
                } else {
                    // おまじない
                    dataSetErrFlg = true;
                }

                // 出向情報と社員情報の状態が不正
                if (dataSetErrFlg) {
                    rtnMessage = GYC08MessageId.GYC08E052;
                    String message =
                            MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                    gYC08IdoJohoHPDto.getNameCd());
                    // エラー処理を実行
                    GYCIdoJohoMsgWDto msgWDto =
                            new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                    doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                    // 異常を返却
                    return NG;

                }
            }

            if (delCnt == 1) {
                // 削除のデータを設定する。
                this.mapper.map(rec1SinDto, gYCIdoJohoHDto);
            }

        }

        // 退職情報
        if (gYC08IdoJohoHPDto.getLstGYCIdoJohoTaishokuJyhDto().size() >= 1) {

            // int addCnt = 0;
            int delCnt = 0;
            GYCIdoJohoTaishokuJyhDto dto = null;
            Iterator<GYCIdoJohoTaishokuJyhDto> itr =
                    gYC08IdoJohoHPDto.getLstGYCIdoJohoTaishokuJyhDto().iterator();
            while (itr.hasNext()) {
                // 人事異動 退職情報を取得する。
                dto = (GYCIdoJohoTaishokuJyhDto) itr.next();

                // 処理種別ごとの件数を算出
                if (GYCIdoJohoConst.SHORISBT_ADD.equals(dto.getTiShoriSbtHyoji())) {
                    // 重複可
                    // addCnt ++;
                } else {
                    delCnt++;
                }

            }

            // 退職情報は重複OK。同一のデータを想定し、後勝ちで処理。
            if (delCnt > 0) {
                rtnMessage = GYC08MessageId.GYC08E049;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }

            // あるはずだけど、警告が出ているのでNullチェック
            if (dto != null) {
                // SPEADかつ死亡フラグがTrueの場合
                if (GYCIdoJohoConst.JSYS_SPEAD.equals(dto.getTiJsysSbtCd()) && siboFlg) {
                    // 退職事由コードが35～38の場合は退職事由コードに死亡を設定する。
                    if (SPEAD_TAIJI_CD_SIBO1.equals(dto.getTaishokujiyuCdBak())
                            || SPEAD_TAIJI_CD_SIBO2.equals(dto.getTaishokujiyuCdBak())
