        }

        // 出向情報の更新処理
        if (gYC08IdoJohoHPDto.getLstGYCIdoJohoSyukkoDto().size() >= 1) {


            boolean dataSetErrFlg = false;

            // １件の場合
            if (gYC08IdoJohoHPDto.getLstGYCIdoJohoSyukkoDto().size() == 1) {

                // 2016/09/23 Update by Matsui 出向元優先に変更
                // 出向情報の共通部を設定
                // setSyukkoJohoComon(gYCIdoJohoHDto,syukkoHukkiKbn, rec1Dto);

                // 出向開始の場合
                if (GYCIdoJohoConst.SYUKKO_KAISHI.equals(syukkoHukkiKbn)) {
                    if (KoseiStringUtils.isEmpty(sakiJsysCd)
                            && !KoseiStringUtils.isEmpty(motoJsysCd)) {
                        // 出向元のみ判明
                        setSyukkoJoho(gYCIdoJohoHDto, syukkoHukkiKbn, rec1Dto, null);

                    } else if (!KoseiStringUtils.isEmpty(sakiJsysCd)
                            && KoseiStringUtils.isEmpty(motoJsysCd)) {
                        // 出向先のみ判明
                        setSyukkoJoho(gYCIdoJohoHDto, syukkoHukkiKbn, null, rec1Dto);

                    } else if (!KoseiStringUtils.isEmpty(sakiJsysCd)
                            && !KoseiStringUtils.isEmpty(motoJsysCd)) {
                        // 出向元・先判明
                        setSyukkoJoho(gYCIdoJohoHDto, syukkoHukkiKbn, rec1Dto, rec1Dto);
                    } else {
                        dataSetErrFlg = true;
                    }
                } else {
                    // 出向復帰（DBから元先の人事システムコードは判定している）
                    if (motoJsysCd.equals(rec1Dto.getJsysSbtCd())) {
                        if (sakiJsysCd.equals(rec1Dto.getJsysSbtCd())) {
                            // 同一人給内の異動(出向元、出向先が一致） (2)、(3) 同一人給の異動
                            setSyukkoJoho(gYCIdoJohoHDto, syukkoHukkiKbn, rec1Dto,
                                    rec1Dto);
                        } else {
                            // 出向元の出向情報しかない。
                            setSyukkoJoho(gYCIdoJohoHDto, syukkoHukkiKbn, rec1Dto, null);
                        }
                    } else if (sakiJsysCd.equals(rec1Dto.getJsysSbtCd())) {
                        // 出向先の出向情報しかない。
                        setSyukkoJoho(gYCIdoJohoHDto, syukkoHukkiKbn, null, rec1Dto);
                    } else {
                        // 人事システムコードが一致しない。
                        dataSetErrFlg = true;
                    }
                }

                // ２件の場合
            } else {

                // 2016/09/23 Update by Matsui 出向元優先に変更
                // 出向情報の共通部を設定
                // setSyukkoJohoComon(gYCIdoJohoHDto,syukkoHukkiKbn, rec2Dto);

                if (!KoseiStringUtils.isEmpty(motoJsysCd)
                        && !KoseiStringUtils.isEmpty(sakiJsysCd)) {
                    if (motoJsysCd.equals(rec1Dto.getJsysSbtCd())) {
                        if (sakiJsysCd.equals(rec2Dto.getJsysSbtCd())) {
                            setSyukkoJoho(gYCIdoJohoHDto, syukkoHukkiKbn, rec1Dto,
                                    rec2Dto);
                        } else {
                            // 出向先の人事システムコードが一致しない。
                            dataSetErrFlg = true;
                        }
                    } else if (motoJsysCd.equals(rec2Dto.getJsysSbtCd())) {
                        if (sakiJsysCd.equals(rec1Dto.getJsysSbtCd())) {
                            setSyukkoJoho(gYCIdoJohoHDto, syukkoHukkiKbn, rec2Dto,
                                    rec1Dto);
                        } else {
                            // 出向先の人事システムコードが一致しない。
                            dataSetErrFlg = true;
                        }
                    } else {
                        // 出向先の人事システムコードが一致しない。
                        dataSetErrFlg = true;
                    }
                } else {
                    // 出向先の人事システムコードが一致しない。
                    dataSetErrFlg = true;
                }
            }

            // 出向情報と社員情報の状態が不正
            if (dataSetErrFlg) {
                rtnMessage = GYC08MessageId.GYC08E052;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;

            }
        }


        // 休職情報
        if (gYC08IdoJohoHPDto.getLstGYCIdoJohoKyusyokuJyhDto().size() >= 1) {

            int addCnt = 0;
            int delCnt = 0;

            GYCIdoJohoKyusyokuJyhDto dto = null;
            Iterator<GYCIdoJohoKyusyokuJyhDto> itr =
                    gYC08IdoJohoHPDto.getLstGYCIdoJohoKyusyokuJyhDto().iterator();
            while (itr.hasNext()) {
                // 人事異動 休職情報を取得する。
                dto = (GYCIdoJohoKyusyokuJyhDto) itr.next();

                // 処理種別ごとの件数を算出
                if (GYCIdoJohoConst.SHORISBT_ADD.equals(dto.getKsShoriSbtHyoji())) {
                    addCnt++;
                } else {
                    delCnt++;
                }

            }
            if (addCnt > 1) {
                rtnMessage = GYC08MessageId.GYC08E046;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }
            if (delCnt > 0) {
                rtnMessage = GYC08MessageId.GYC08E049;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }


            // 休職情報の設定
            this.mapper.map(dto, gYCIdoJohoHDto);
        }



        // 転籍情報
        if (gYC08IdoJohoHPDto.getLstGYCIdoJohoTensekiJyhDto().size() >= 1) {

            int addCnt = 0;
            int delCnt = 0;
            GYCIdoJohoTensekiJyhDto dto = null;
            Iterator<GYCIdoJohoTensekiJyhDto> itr =
                    gYC08IdoJohoHPDto.getLstGYCIdoJohoTensekiJyhDto().iterator();
            while (itr.hasNext()) {
                // 人事異動 転籍情報を取得する。
                dto = (GYCIdoJohoTensekiJyhDto) itr.next();

                // 処理種別ごとの件数を算出
                if (GYCIdoJohoConst.SHORISBT_ADD.equals(dto.getTsShoriSbtHyoji())) {
                    addCnt++;
                } else {
                    delCnt++;
                }
            }
            if (addCnt > 1) {
                rtnMessage = GYC08MessageId.GYC08E046;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }
            if (delCnt > 0) {
                rtnMessage = GYC08MessageId.GYC08E049;
                String message =
                        MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                gYC08IdoJohoHPDto.getNameCd());
                // エラー処理を実行
                GYCIdoJohoMsgWDto msgWDto =
                        new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                // 異常を返却
                return NG;
            }


            // 転籍情報の設定
            this.mapper.map(dto, gYCIdoJohoHDto);

        }

        // 組み合わせパラメータリスト
        List<String> lstKumiParam = new ArrayList<>();
        if (GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getSJohoUmu())) {

            String sinsaiKbn = gYCIdoJohoHDto.getSSinsaiSaisaiyoKbnCd();
            // COM人給の場合、発令を伴わない社員情報の変更の場合、新採・再採用区分コード
            // が前回の値できてしまう対応。
            if (GYCIdoJohoConst.JSYS_COMS.equals(gYCIdoJohoHDto.getSJsysSbtCd()) ||
                    GYCIdoJohoConst.JSYS_SPEAD.equals(gYCIdoJohoHDto.getSJsysSbtCd())) {
                sinsaiKbn = comsSinsaiSaiyoKbnChk(sinsaiKbn, gYCIdoJohoHDto.getNameCd());
            }

            // 出向情報と転籍情報が存在する場合、社員情報はパターンチェックの対象外とする。
            if (!(GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getSkJohoUmu())
                    || GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getSfJohoUmu())
                    || GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getTsUmu()))) {

                // 新採・再採用区分コードの存在チェック
                switch (sinsaiKbn) {
                    case GYCIdoJohoConst.SHINSAI_SAIYO:
                        lstKumiParam.add("1");
                        break;
                    case GYCIdoJohoConst.SHINSAI_ISEKI:
                        lstKumiParam.add("2");
                        break;
                    case GYCIdoJohoConst.SHINSAI_SAISAIYO:
                        lstKumiParam.add("3");
                        break;
                    case " ":
                        lstKumiParam.add("4");
                        break;
                    default:
                        break;
                }
            }
        }
        if (GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getTiJohoUmu())) {
            // 組み合わせ情報作成
            if (GYCIdoJohoConst.TAISHOKU_RIYU_ISEKI
                    .equals(gYCIdoJohoHDto.getTiTaishokujiyuCd())) {
                lstKumiParam.add("6");
            } else {
                lstKumiParam.add("5");
            }
        }
        if (GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getIJohoUmu())) {
            // 組み合わせ情報作成
            lstKumiParam.add("7");
        }
        if (GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getSkJohoUmu())) {
            // 組み合わせ情報作成
            lstKumiParam.add("8");
        }
        if (GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getSfJohoUmu())) {
            // 組み合わせ情報作成
            lstKumiParam.add("9");
        }
        if (GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getKsJohoUmu())) {
            if (gYCIdoJohoHDto.getKsHksykDt() == null) {
                // 休職
                lstKumiParam.add("A");
            } else {
                // 復職
                lstKumiParam.add("B");
            }
        }
        if (GYCIdoJohoConst.JOHO_UMU_ON.equals(gYCIdoJohoHDto.getTsUmu())) {
            // 組み合わせ情報作成
            lstKumiParam.add("C");
        }



        // 組み合わせ情報を取得
        GYC08SokanCheckDto sokanDto = new GYC08SokanCheckDto();
        Collections.sort(lstKumiParam);
        StringBuffer paramas = new StringBuffer();
        Iterator<String> itr = lstKumiParam.iterator();
        int paramCnt = 0;
        while (itr.hasNext()) {
            String param = itr.next();
            paramCnt++;

            if (paramCnt == 1) {
                sokanDto.setIdoSbtkansokancheckchi1(param);
            } else if (paramCnt == 2) {
                sokanDto.setIdoSbtkansokancheckchi2(param);
            } else if (paramCnt == 3) {
                sokanDto.setIdoSbtkansokancheckchi3(param);
            }
            paramas.append(param).append(",");
        }

        this.klogger.debug("    相関チェック組み合わせパターン:{}", paramas.toString());

        // 複数件あれば組み合わせチェックを行う
        if (paramCnt >= 2 && paramCnt < 4) {
            // 異動種別間相関チェックに登録済みのパターンであるかを確認する。
            GYC08SokanCheckDto rtnsokanDto = this.gyc08Dao.findChkSokanCheck(sokanDto);
            if (rtnsokanDto == null) {
                if (paramCnt == 2) {
                    rtnMessage = GYC08MessageId.GYC08E054;
                    String message =
                            MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                    gYC08IdoJohoHPDto.getNameCd());
                    // エラー処理を実行
                    GYCIdoJohoMsgWDto msgWDto =
                            new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                    doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                    // 異常を返却
                    return NG;
                } else if (paramCnt == 3) {
                    rtnMessage = GYC08MessageId.GYC08E055;
                    String message =
                            MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                                    gYC08IdoJohoHPDto.getNameCd());
                    // エラー処理を実行
                    GYCIdoJohoMsgWDto msgWDto =
                            new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
                    doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
                    // 異常を返却
                    return NG;
                }
            }

        } else if (paramCnt >= 4) {

            rtnMessage = GYC08MessageId.GYC08E056;
            // ４種類以上のデータがある。
            String message =
                    MessageFormat.format(this.messageAccessor.getText(rtnMessage),
                            gYC08IdoJohoHPDto.getNameCd());
            // エラー処理を実行
            GYCIdoJohoMsgWDto msgWDto =
                    new GYCIdoJohoMsgWDto(rtnMessage.toString(), message);
            doIdoJohoErrOut2(gYC08IdoJohoHPDto, msgWDto);
            // 異常を返却
            return NG;
        }

        return OK;
    }



    /**
     * <p>[概 要] comsSinsaiSaiyoKbnChk メソッド。</p>
     * <p>[詳 細] COMS新採・再採用区分コードチェック</p>
     * <p>[備 考] COM人給の場合、発令を伴わない社員情報の変更の場合、新採・再採用区分コードが前回値できてしまう対応。</p>
     *
     * @param sinsaiKbn 新採・再採用区分コード
     * @param nameCode 社員氏名コード
     * @return チェック済み新採・再採用区分コード
     */
    private String comsSinsaiSaiyoKbnChk(String sinsaiKbn, String nameCode) {

        String chkSinsaiKbn = sinsaiKbn;
        // 社員テーブルの値
        GYCShainJohoDto shinTblDto = new GYCShainJohoDto();
        // 共通関数から社員テーブルの値を取得
        shinTblDto = this.gYCIdoJohoDao.findShainJoho(nameCode);
        // 前回の新採・再採用区分コード（採用種別コード）を取得する。
        if (shinTblDto != null && shinTblDto.getSaiyoSbtCd() != null) {
            if (shinTblDto.getSaiyoSbtCd().equals(sinsaiKbn)) {
                
                if(!GYCIdoJohoConst.ZAISHOKU_KBN_TAISHOKU
                        .equals(shinTblDto.getZaishokKbnCd())){
                    
                    // 更新前社員情報が退職ではない かつ 前回値と一致した場合、その他へ変更する
                    chkSinsaiKbn = " ";
                }
            }
        }

        return chkSinsaiKbn;
    }



    /**
     * <p>[概 要] doIdoJohoToroku メソッド。</p>
     * <p>[詳 細] 異動情報登録処理</p>
     * <p>[備 考] </p>
     *
     * @param gYC08IdoJohoHPDto 異動情報振分前DTO
     * @param gYCIdoJohoHDto 異動情報振分済みDTO
     * @param exsistFlg データ存在フラグ
     */
    private void doIdoJohoToroku(GYC08IdoJohoHPDto gYC08IdoJohoHPDto,
            GYCIdoJohoHDto gYCIdoJohoHDto, boolean exsistFlg) {

        this.klogger.debug("【 登録処理 開始 】   社員氏名コード:{} 異動発生年月日:{}--> ",
                gYCIdoJohoHDto.getNameCd(), gYCIdoJohoHDto.getIdohasseinengappi());


        // データが存在していた場合は該当データを削除します。
        if (exsistFlg) {
            int delCnt = 0;
            // 削除する。
            delCnt = this.gyc08Dao.deleteIdoJohoHByPk(gYCIdoJohoHDto);
            this.klogger.debug("    該当データ削除 件数：{}", delCnt);
        }


        // 人事異動情報振分済みワークTbl 登録 !
        this.gyc08Dao.insertIdoJohoH(gYCIdoJohoHDto);


        // メッセージ作成
        String rstMsg = "";
        boolean wrnFlg = false;
        // 共通部
        if (KoseiStringUtils.isEmpty(gYC08IdoJohoHPDto.getShimei())
                && KoseiStringUtils.isEmpty(gYC08IdoJohoHPDto.getKaishaNm())) {
            rstMsg = MessageFormat.format(RST_MSG2, gYC08IdoJohoHPDto.getNameCd());
        } else {
            rstMsg = MessageFormat.format(RST_MSG1, gYC08IdoJohoHPDto.getNameCd(),
                    gYC08IdoJohoHPDto.getShimei(), gYC08IdoJohoHPDto.getKaishaNm(),
                    gYC08IdoJohoHPDto.getSosikiNm());
        }
        // 警告メッセージ
        Iterator<String> msgItr = gYC08IdoJohoHPDto.getLstWrnMsg().iterator();
        while (msgItr.hasNext()) {
            rstMsg = rstMsg + ";" + msgItr.next();
            wrnFlg = true;
        }

        // 異動情報メッセージワークの作成
        GYCIdoJohoMsgWDto msgWDto = new GYCIdoJohoMsgWDto(rstMsg);
        msgWDto.setJobId(this.functionId);
        msgWDto.setCreateUserId(gYC08IdoJohoHPDto.getCreateUserId());
        msgWDto.setLastUpdateUserId(gYC08IdoJohoHPDto.getLastUpdateUserId());
        msgWDto.setNameCd(gYC08IdoJohoHPDto.getNameCd());
        msgWDto.setIdohasseinengappi(gYC08IdoJohoHPDto.getIdohasseinengappi());
        if (wrnFlg) {
            // レベルを(W)で登録
            msgWDto.setErrLevel("W");
        } else {
            // レベルを(I)で登録
            msgWDto.setErrLevel("I");
        }


        int nomalCnt = 0;

        Iterator<GYC08IdoJohoCDto> itr =
                gYC08IdoJohoHPDto.getLstGYC08IdoJohoCDto().iterator();
        while (itr.hasNext()) {
            // 人事異動情報を取得する。
            GYC08IdoJohoCDto dto = (GYC08IdoJohoCDto) itr.next();
            msgWDto.setJinjiidojyh(dto.getJinjiidojyh());
            msgWDto.setJsysSbtCd(dto.getJsysSbtCd());
            msgWDto.setIdoSbtCd(dto.getIdoSbtCd());
            msgWDto.setIdofilegyoNo(dto.getIdofilegyoNo());

            GYC08IdoJohoMsgWRstFileDto msgWFileDto = new GYC08IdoJohoMsgWRstFileDto();
            // エラー情報に情報をコピーする。
            this.mapper.map(msgWDto, msgWFileDto);

            // 人事システムコード(和名変換）
            Map<String, String> jsysCodeMap = jsysCodeList.asMap();
            if (!jsysCodeMap.containsKey(dto.getJsysSbtCd())) {
                if (GYCIdoJohoConst.JSYS_SONOTA.equals(dto.getJsysSbtCd())) {
                    msgWFileDto.setJsysSbtCd(JSYS_SONOT_NM);
                } else {
                    msgWFileDto.setJsysSbtCd(dto.getJsysSbtCd());
                }
            } else {
                msgWFileDto.setJsysSbtCd(jsysCodeMap.get(dto.getJsysSbtCd()));
            }
            // ファイルへデータを出力
            msgWFileDto.setErrMsg("\"" + msgWFileDto.getErrMsg() + "\"");
            msgWFileDto.setNameCd("\"" + msgWFileDto.getNameCd() + "\"");
            if (!KoseiStringUtils.isEmpty(msgWFileDto.getIdohasseinengappi())) {
                msgWFileDto.setIdohasseinengappi(
                        msgWFileDto.getIdohasseinengappi().replace("-", "/"));
            }
            msgWFileDto.setIdohasseinengappi(
                    "\"" + msgWFileDto.getIdohasseinengappi() + "\"");
            msgWFileDto.setJsysSbtCd("\"" + msgWFileDto.getJsysSbtCd() + "\"");
            msgWFileDto.setIdofilegyoNo("\"" + msgWFileDto.getIdofilegyoNo() + "\"");

            rstlistFileLineWriter.writeData(msgWFileDto);
            // 人事異動情報メッセージワークへ登録する。
            this.gyc08Dao.insertIdoJohoMsgW(msgWDto);



            nomalCnt++;
        }

        gYC08IdoJohoHPDto.setNomalCnt(nomalCnt);
        this.klogger.debug("【 登録処理 終了 】    対象件数:{} ", nomalCnt);
    }

