    /**
     * <p>[概 要] doIdoJohoErrOut メソッド。</p>
     * <p>[詳 細] 異動情報エラー情報出力処理</p>
     * <p>[備 考] </p>
     *
     * @param gYC08IdoJohoCDto 人事異動情報
     * @param msgWDto 人事異動情報メッセージワーク
     */
    private void doIdoJohoErrOut(GYC08IdoJohoCDto gYC08IdoJohoCDto,
            GYCIdoJohoMsgWDto msgWDto) {
        // エラー情報に情報をコピーする。
        this.mapper.map(gYC08IdoJohoCDto, msgWDto);
        // その他の項目設定
        msgWDto.setJobId(this.functionId);
        if (!KoseiStringUtils.isEmpty(msgWDto.getErrMsgId())
                && msgWDto.getErrMsgId().length() == 9) {
            msgWDto.setErrLevel(msgWDto.getErrMsgId().substring(5, 6));
        }
        msgWDto.setCreateUserId(gYC08IdoJohoCDto.getOperUserId());
        msgWDto.setLastUpdateUserId(gYC08IdoJohoCDto.getOperUserId());

        GYC08IdoJohoMsgWErrFileDto msgWFileDto = new GYC08IdoJohoMsgWErrFileDto();
        // エラー情報に情報をコピーする。
        this.mapper.map(msgWDto, msgWFileDto);

        // 人事システムコード(和名変換）
        Map<String, String> jsysCodeMap = jsysCodeList.asMap();
        if (!jsysCodeMap.containsKey(gYC08IdoJohoCDto.getJsysSbtCd())) {
            if (GYCIdoJohoConst.JSYS_SONOTA.equals(gYC08IdoJohoCDto.getJsysSbtCd())) {
                msgWFileDto.setJsysSbtCd(JSYS_SONOT_NM);
            } else {
                msgWFileDto.setJsysSbtCd(gYC08IdoJohoCDto.getJsysSbtCd());
            }
        } else {
            msgWFileDto.setJsysSbtCd(jsysCodeMap.get(gYC08IdoJohoCDto.getJsysSbtCd()));
        }

        // ファイルへデータを出力
        msgWFileDto.setErrMsg("\"" + msgWFileDto.getErrMsg() + "\"");
        msgWFileDto.setNameCd("\"" + msgWFileDto.getNameCd() + "\"");
        if (!KoseiStringUtils.isEmpty(msgWFileDto.getIdohasseinengappi())) {
            msgWFileDto.setIdohasseinengappi(
                    msgWFileDto.getIdohasseinengappi().replace("-", "/"));
        }
        msgWFileDto
                .setIdohasseinengappi("\"" + msgWFileDto.getIdohasseinengappi() + "\"");
        msgWFileDto.setJsysSbtCd("\"" + msgWFileDto.getJsysSbtCd() + "\"");
        msgWFileDto.setIdofilegyoNo("\"" + msgWFileDto.getIdofilegyoNo() + "\"");

        errlistFileLineWriter.writeData(msgWFileDto);

        // 人事異動情報メッセージワークへ登録する。
        this.gyc08Dao.insertIdoJohoMsgW(msgWDto);

        // 有効フラグに無効を設定
        gYC08IdoJohoCDto.setYukoRecFlg(MUKO);

        // Logにエラーメッセージを出力
        this.klogger.error("【 エラー処理 】 ErrMsgId:{}  ErrMsg:{}", msgWDto.getErrMsgId(),
                msgWDto.getErrMsg());

    }


    /**
     * <p>[概 要] doIdoJohoErrOut2 メソッド。</p>
     * <p>[詳 細] 異動情報エラー情報出力処理２（複数の異動情報）</p>
     * <p>[備 考] </p>
     *
     * @param gYC08IdoJohoHPDto 異動情報振分前ＤＴＯ
     * @param msgWDto 異動情報メッセージワークDTO
     */
    private void doIdoJohoErrOut2(GYC08IdoJohoHPDto gYC08IdoJohoHPDto,
            GYCIdoJohoMsgWDto msgWDto) {

        msgWDto.setJobId(this.functionId);
        msgWDto.setCreateUserId(gYC08IdoJohoHPDto.getCreateUserId());
        msgWDto.setLastUpdateUserId(gYC08IdoJohoHPDto.getLastUpdateUserId());

        msgWDto.setNameCd(gYC08IdoJohoHPDto.getNameCd());
        msgWDto.setIdohasseinengappi(gYC08IdoJohoHPDto.getIdohasseinengappi());
        if (!KoseiStringUtils.isEmpty(msgWDto.getErrMsgId())
                && msgWDto.getErrMsgId().length() == 9) {
            msgWDto.setErrLevel(msgWDto.getErrMsgId().substring(5, 6));
        }

        Map<String, String> jsysCodeMap = jsysCodeList.asMap();
        int errorCnt = 0;
        Iterator<GYC08IdoJohoCDto> itr =
                gYC08IdoJohoHPDto.getLstGYC08IdoJohoCDto().iterator();
        while (itr.hasNext()) {
            // 人事異動情報を取得する。
            GYC08IdoJohoCDto dto = (GYC08IdoJohoCDto) itr.next();
            msgWDto.setJinjiidojyh(dto.getJinjiidojyh());
            msgWDto.setJsysSbtCd(dto.getJsysSbtCd());
            msgWDto.setIdoSbtCd(dto.getIdoSbtCd());
            msgWDto.setIdofilegyoNo(dto.getIdofilegyoNo());

            GYC08IdoJohoMsgWErrFileDto msgWFileDto = new GYC08IdoJohoMsgWErrFileDto();
            // エラー情報に情報をコピーする。
            this.mapper.map(msgWDto, msgWFileDto);

            // 人事システムコード(和名変換）
            if (!jsysCodeMap.containsKey(dto.getJsysSbtCd())) {
                if (GYCIdoJohoConst.JSYS_SONOTA.equals(dto.getJsysSbtCd())) {
                    msgWFileDto.setJsysSbtCd(JSYS_SONOT_NM);
                } else {
                    msgWFileDto.setJsysSbtCd(dto.getJsysSbtCd());
                }
            } else {
                msgWFileDto.setJsysSbtCd(jsysCodeMap.get(dto.getJsysSbtCd()));
            }

            // ファイルへデータを出力
            msgWFileDto.setErrMsg("\"" + msgWFileDto.getErrMsg() + "\"");
            msgWFileDto.setNameCd("\"" + msgWFileDto.getNameCd() + "\"");
            if (!KoseiStringUtils.isEmpty(msgWFileDto.getIdohasseinengappi())) {
                msgWFileDto.setIdohasseinengappi(
                        msgWFileDto.getIdohasseinengappi().replace("-", "/"));
            }
            msgWFileDto.setIdohasseinengappi(
                    "\"" + msgWFileDto.getIdohasseinengappi() + "\"");
            msgWFileDto.setJsysSbtCd("\"" + msgWFileDto.getJsysSbtCd() + "\"");
            msgWFileDto.setIdofilegyoNo("\"" + msgWFileDto.getIdofilegyoNo() + "\"");

            errlistFileLineWriter.writeData(msgWFileDto);

            // 人事異動情報メッセージワークへ登録する。
            this.gyc08Dao.insertIdoJohoMsgW(msgWDto);

            errorCnt++;

        }
        gYC08IdoJohoHPDto.setErrorCnt(errorCnt);

        this.klogger.error("【 エラー処理 】 ErrMsgId:{}  ErrMsg:{}", msgWDto.getErrMsgId(),
                msgWDto.getErrMsg());

    }

