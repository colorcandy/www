                        gYCIdoJohoHDto
                                .setSfShukkouSakiMail(syukkoMoto.getShukkouSakiMail());
                    }
                } else {
                    gYCIdoJohoHDto.setSfShukkouSakiMail(shinTblDto.getShukkouSakiMail());
                }

            }

        }
