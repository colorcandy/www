/**
     * コンストラクタ。
     * 
     * <p>[概 要] コンストラクタ。</p>
     * <p>[詳 細] <br>
     * コンストラクタ。
     * </p>
     * <p>[備 考] </p>
     */
    public KoseiFullWidthChars() {
        super(/* JIS非漢字 */ new KoseiSpecialChars()
                .union(/* JIS X 0208 の3区：英数字 */ new JIS_X_0208_LatinLetters())
                .union(/* JIS X 0208 の4区：ひらがな */ new JIS_X_0208_Hiragana())
                .union(/* 全角カタカナ */ new KoseiFullWidthKatakanaChars())
                .union(/* JIS X 0208 の6区：ギリシア文字 */ new JIS_X_0208_GreekLetters())
                .union(/* JIS X 0208 の7区：キリル文字 */ new JIS_X_0208_CyrillicLetters())
                .union(/* JIS X 0208 の8区：罫線素片 */ new JIS_X_0208_BoxDrawingChars())
                .union(/* JIS X 208で規定される漢字 第1、第2水準漢字 */ new JIS_X_0208_Kanji())
                .union(/* NEC特殊文字 */ new KoseiNECSpecialChars())
                .union(/* NEC選定IBM拡張文字 */ new KoseiNECSelectionsIBMExtensionChars())
                .union(/* IBM拡張文字 */ new KoseiIBMExtensionChars()));
    }
