            GYCIdoJohoDtoAbst idoJohoDtoAbst) {
        
        // 振分前DTOの社員情報に登録する。
        gYC08IdoJohoHPDto.getLstGYCIdoJohoSinJyhDto().add((GYCIdoJohoSinJyhDto)idoJohoDtoAbst);
        
    }











